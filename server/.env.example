# Chuỗi kết nối MongoDB (Atlas → Connect → Drivers), nhớ thêm tên database sau dấu /
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-studio
# Chuỗi ngẫu nhiên 64+ ký tự. Đổi chuỗi này là đăng xuất mọi người.
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-that-dai
# Cloudinary → Settings → API Keys
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
# Tạo xong tài khoản cho nhóm thì đặt false
ALLOW_REGISTER=true
# Tên đăng nhập luôn là quản trị viên, cách nhau dấu phẩy (hoặc chạy npm run make-admin -- <tên>)
# ADMIN_USERNAMES=minh
# Nhật ký thao tác tự xoá sau bao nhiêu ngày (mặc định 2)
# LOG_RETENTION_DAYS=2
PORT=4000
# NODE_ENV=production
# CLIENT_ORIGIN=http://localhost:5173
# Google Drive chung của team (tài liệu 12). Google Cloud Console → OAuth client loại "Web application".
# GOOGLE_REDIRECT_URI = địa chỉ mở app + /api/drive/callback, khai báo y hệt trong "Authorized redirect URIs".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/drive/callback
# DRIVE_FOLDER_NAME=Xưởng Prompt
# DRIVE_MAX_UPLOAD_MB=500
# 2 khi giao diện ở Vercel và /api đi qua rewrite sang Render; 1 khi chỉ có Render
# TRUST_PROXY=1
