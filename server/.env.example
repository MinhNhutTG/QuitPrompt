# Chuỗi kết nối MongoDB (Atlas → Connect → Drivers), nhớ thêm tên database sau dấu /
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-studio
# Chuỗi ngẫu nhiên 64+ ký tự. Đổi chuỗi này là đăng xuất mọi người.
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-that-dai
# Cloudinary → Settings → API Keys
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
# Tạo xong tài khoản cho nhóm thì đặt false
ALLOW_REGISTER=true
PORT=4000
# NODE_ENV=production
# CLIENT_ORIGIN=http://localhost:5173
# 2 khi giao diện ở Vercel và /api đi qua rewrite sang Render; 1 khi chỉ có Render
# TRUST_PROXY=1
